# Copy to .env and uncomment what you need. .env is gitignored, the training entry
# points load it, and setup.sh and the launch scripts source it for their own vars.
#
# Leave a variable COMMENTED OUT rather than empty: the configs read it with
# ${oc.env:VAR,default}, and an exported empty string wins over the default.
#
# The W&B project is not an env var: it defaults to <suite>-<trainer> and is set
# per run with wandb.project=<name>.

# --- Data. The two builds share a directory name, so they cannot share a root. ---
# BWB_DATA_ROOT=                 # fallback for the three below, or pass data_root= on the command line
# BWB_DATA_ROOT_ALL_UNITS=       # TS1
# BWB_DATA_ROOT_SELECTED_UNITS=  # TS2, TS3 (eval and pretraining)
# BWB_DATA_ROOT_PRETRAIN=        # src/pretrain, either build

# --- Outputs. CWD-relative, so set them if you run from outside the repo root. ---
# BWB_CKPT_DIR=         # default ./ckpt; set it if jobs on different nodes share checkpoints
# BWB_PREDICTIONS_DIR=  # default ./predictions
# BWB_EMBS_DIR=         # default ./embs, TS3 unit embeddings
# BWB_CACHE_DIR=        # default ./cache, TS3 waveform/ACG cache

# --- Weights & Biases. Nothing is uploaded until WANDB_MODE=online. ---
# WANDB_MODE=online  # online | offline | disabled (the default)
# WANDB_API_KEY=     # online needs it, from https://wandb.ai/authorize
# WANDB_ENTITY=      # default: your own entity
# WANDB_DIR=         # default ./wandb, where offline runs are kept

# --- Ray, for tune.py ---
# RAY_ADDRESS=          # an existing cluster; unset starts a local one
# RAY_TMPDIR=           # default /tmp/ray
# BWB_RAY_RESULTS_DIR=  # default ./ray_results, shared filesystem on a multi-node cluster
# BWB_RAY_OUTPUTS_DIR=  # default ./ray_outputs

# --- Cluster launch scripts (src/*/scripts/tune.sh, src/*/scripts/**/*.sbatch) ---
# VENV_DIR=        # where setup.sh builds the venv and the .sbatch scripts look for it
# REPO_DIR=        # defaults to SLURM_SUBMIT_DIR; set it if you submit from outside the repo
# DATA_ROOT=       # passed as data_root=, overriding every BWB_DATA_ROOT variable
# EIDS_FILE=       # session list to fan out over
# LOG_DIR=         # job logs, for the submit_all_*.sh wrappers
# PRED_DIR=        # stat-baseline predictions, default <repo>/predictions
# NUM_GPUS=
# GPU_PAD_TARGET=  # GPU padder utilization target, default 0.4

# --- Slurm. sbatch reads these from the submitting shell, so run
# `set -a; source .env; set +a` before a bare sbatch; submit_all_*.sh does it for you. ---
# SBATCH_PARTITION=
# SBATCH_ACCOUNT=
# SBATCH_QOS=
# SBATCH_RESERVATION=
# SBATCH_TIMELIMIT=  # overrides a script's --time
